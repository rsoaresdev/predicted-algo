# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# --- Alpaca API (alpaca-py SDK) ---
# The URL below selects the environment: a "paper" URL puts the SDK in paper
# mode, anything else uses live trading.
#   Paper (recommended while developing): https://paper-api.alpaca.markets
#   Live trading:                         https://api.alpaca.markets
ALPACA_API_KEY_ID=your_key_id_here
ALPACA_API_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market-data feed: "iex" (free) or "sip" (paid, full-market consolidated)
ALPACA_DATA_FEED=iex

# --- PostgreSQL (self-hosted) ---
# Either provide a full DATABASE_URL...
# DATABASE_URL=postgresql+psycopg2://trader:password@localhost:5432/trading_bot
# ...or the individual parts below (used only if DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trader
DB_PASSWORD=change_me

# --- Risk / engine tuning ---
# Fraction of equity risked per trade. Also defines the ATR sizing rule:
# 1 ATR of price movement == RISK_PER_TRADE of total equity (default 1%).
RISK_PER_TRADE=0.01
ATR_PERIOD=14
# Seconds between engine evaluation cycles.
POLL_SECONDS=60
# DRY_RUN=true  -> compute & log signals/orders but DO NOT submit to the broker.
# DRY_RUN=false -> submit real orders to the configured Alpaca endpoint.
DRY_RUN=true

# --- Trailing stop ---
# The entry stop is a fixed 1-ATR (==RISK_PER_TRADE) hard stop. With trailing on
# it then ratchets in the trade's favour and never loosens: it locks to
# breakeven once price runs TRAIL_BREAKEVEN_ATR ATR in profit, then trails
# TRAIL_DISTANCE_ATR ATR behind the best price reached. Defaults below were
# A/B-validated (see config.py) — a tighter 2-ATR trail whipsaws the 1Hour
# sleeves. Set USE_TRAILING_STOP=false to revert to the fixed entry stop.
USE_TRAILING_STOP=true
TRAIL_BREAKEVEN_ATR=1.5
TRAIL_DISTANCE_ATR=4.0

# --- Market-regime filter (OFF by default) ---
# When on, new longs in the equity sleeve (QQQ/EWG/EEM) are only allowed while
# REGIME_SYMBOL is above its REGIME_SMA-day SMA. A/B showed it does NOT improve
# the current book (the strategies are already trend-filtered) — left off. Flip
# to true only after re-validating: `python backtester.py --account 2000 --years 3 --regime`.
USE_REGIME_FILTER=false
REGIME_SYMBOL=SPY
REGIME_SMA=200

# --- Portfolio safety guards (risk/guards.py) ---
# Drawdown circuit-breaker: stop opening NEW positions when equity is this far
# below its high-water mark; resume above DRAWDOWN_RESUME_PCT. Defaults sit ABOVE
# the validated backtest drawdown (~-5%) so they're pure live tail-insurance —
# A/B confirmed identical results with them on vs off. 0 disables.
DRAWDOWN_HALT_PCT=0.10
DRAWDOWN_RESUME_PCT=0.06
# Daily max-loss kill-switch: stop new entries for the rest of the (UTC) day once
# the day's REALIZED loss exceeds this fraction of the day's starting equity.
MAX_DAILY_LOSS_PCT=0.06

# --- MACD exit gating (default ON, A/B-validated) ---
# macd_trend exits a long only when MACD crosses down AND price is below its SMA
# trend filter (vs on every cross), letting the trailing stop manage winners.
MACD_EXIT_REQUIRES_TREND=true

# --- Initial stop width (default 1.5 ATR, A/B-validated — biggest win-rate gain) ---
# Position is sized so a stop-out always loses exactly RISK_PER_TRADE, so a wider
# stop just means a smaller position with room to ride out entry noise. 1.5 ATR
# lifted win 24%->29% and Sharpe 2.20->2.45 (3y). See config.py for the full A/B.
STOP_ATR_MULT=1.5

# --- Scale-out / partial profit-taking (TESTED, kept OFF; see config.py) ---
# Nearly doubles win rate (29%->46%) but LOWERS return (+102%->+81%) and Sharpe
# by capping the big runners. Backtester-only for now (live path not wired) —
# keep at 0 for live trading.
SCALE_OUT_FRAC=0
SCALE_OUT_ATR=3.0

# --- Entry filters that were tested and REJECTED (kept off; here for the record) ---
# Both HURT on this book (they reshuffle which trades the shared cash funds and
# also block the re-entries that resume into the big winners). Leave at 0.
REENTRY_COOLDOWN_BARS=0
ADX_MIN=0
ADX_PERIOD=14

# --- Alerting (optional) ---
# Push stop-outs, guard trips, errors and a daily summary to Telegram. Leave
# blank to log-only (no external calls). Create a bot via @BotFather, then get
# your chat id from https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
