# Copy to .env.local for development. In production these go in
# /etc/dashboard/dashboard.env (mode 0600).

# Read-only role (dashboard_ro). The dashboard never writes.
DATABASE_URL=postgres://dashboard_ro:devpassword@localhost:5433/predicted
# Optional: maximum connections in the pool.
DB_POOL_MAX=5

# Only for `npm run seed`: a role that can write to a development database.
SEED_DATABASE_URL=postgres://postgres:postgres@localhost:5433/predicted

# Public URL of the dashboard, with HTTPS in production.
AUTH_URL=http://localhost:3000

# Run `npm run setup:admin` to generate these five values.
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
TOTP_ENCRYPTION_KEY=
TOTP_SECRET_ENC=
